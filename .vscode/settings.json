{
  "files.associations": {
    "*.cpp": "cpp",
    "*.h": "cpp",
    "*.hpp": "cpp",
    "iostream": "cpp",
    "string": "cpp",
    "vector": "cpp"
  },
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on"
  },
  "editor.suggestOnTriggerCharacters": true,
  "code-runner.ignoreSelection": true,
  "code-runner.runInTerminal": true
}
